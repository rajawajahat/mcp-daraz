# Get these from: Daraz Seller Center → Store → API Test Tool
DARAZ_APP_KEY=           # Numeric app key
DARAZ_APP_SECRET=        # Long alphanumeric secret
DARAZ_ACCESS_TOKEN=      # OAuth access token
DARAZ_COUNTRY=PK         # PK | BD | LK | NP | MM  (default: PK)
DARAZ_SANDBOX=true       # true = sandbox mode (default), false = production
