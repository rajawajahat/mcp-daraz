{
  "name": "mcp-daraz",
  "version": "1.0.0",
  "description": "The first MCP server for Daraz — manage your store from your AI agent across Pakistan, Bangladesh, Sri Lanka, Nepal & Myanmar",
  "main": "dist/index.js",
  "bin": {
    "mcp-daraz": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "prepublishOnly": "npm run build && npm run test:unit"
  },
  "keywords": [
    "mcp",
    "daraz",
    "pakistan",
    "bangladesh",
    "sri-lanka",
    "nepal",
    "myanmar",
    "ecommerce",
    "seller",
    "lazada",
    "alibaba",
    "model-context-protocol",
    "south-asia"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
